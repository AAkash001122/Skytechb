PORT=5000
# Local: mongodb://127.0.0.1:27017/skytech  |  Atlas: mongodb+srv://<user>:<password>@<cluster>/<db>?appName=<app>
MONGODB_URI=

# Comma-separated list of EVERY frontend origin allowed to call this API (no path; a trailing slash is tolerated).
# Production example: CORS_ORIGIN=http://localhost:5173,https://your-site.vercel.app
# If your deployed frontend is missing here, the browser blocks login, the admin panel and music uploads.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Public frontend URL, used in admin password-reset email links
FRONTEND_URL=http://localhost:5173

# Auth: random string, 32+ chars (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=8h

# SMTP used for admin replies and password-reset emails (e.g. Gmail app password, Brevo, SendGrid)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SkyTech <you@example.com>"

# Max size (MB) of an uploaded welcome/admin MP3. Files are stored in MongoDB GridFS (bucket "audio"), so they persist with your database.
AUDIO_MAX_MB=5

# Only used by `npm run create-admin` (remove ADMIN_PASSWORD afterwards)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
